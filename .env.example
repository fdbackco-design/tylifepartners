# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin
ADMIN_ID=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# SMTP (메일 알림)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# 알림 수신자 (기본값: )
LEAD_NOTIFY_TO=

# Google Sheets (상담 신청 자동 기록)
# - 아래 시트를 서비스계정 이메일로 공유해 주세요 (편집 권한)
# - 시트명 기본값: "시트1"
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_SHEET_NAME=
# 본사 시트 (미설정 시 GOOGLE_SHEETS_ID 또는 기본 HQ ID 사용)
# HQ_SPREADSHEET_ID=1tHi28hTsRMVeQCEDiAmLFy9fe_ox8Bp82jPenWfTTqw
# HQ_SHEET_NAME=시트1
# 담당자 G열 저장 후 Apps Script 동기화 (서버 전용 — 프론트 노출 금지)
# 1) Apps Script → 프로젝트 설정 → 스크립트 속성: HQ_MANAGER_SYNC_SECRET = 아래와 동일한 값
# 2) 배포 → 웹 앱 → URL을 …/exec 로 복사
# HQ_MANAGER_SYNC_WEB_APP_URL=
# HQ_MANAGER_SYNC_SECRET=
# 구글 시트 기록 제외 연락처 (쉼표/세미콜론/줄바꿈 구분, 숫자만 사용 권장)
# GOOGLE_SHEETS_PHONE_BLACKLIST=01012345678,010-9876-5432
# 상담 신청 자체를 차단할 연락처 (쉼표/세미콜론/줄바꿈 구분)
# - 해당 번호는 DB 저장·구글 시트·담당자 분배·이메일·CRM 동기화를 전부 건너뛰고,
#   고객 화면에는 기존과 동일한 성공 응답만 반환한다(차단 사실을 노출하지 않음)
# - 실제 번호는 개인정보이므로 저장소가 아닌 .env.local / Vercel 환경변수에만 기재
# LEAD_BLOCKED_PHONES=01012345678,010-9876-5432
# 랜딩 스크롤·히트맵 분석 제외 IP (쉼표/세미콜론/줄바꿈 구분, 회사 고정 IP)
# LANDING_ANALYTICS_IP_EXCLUDE=123.456.789.0
# 관리자 랜딩 생성 이미지/브로셔 업로드용 Supabase Storage 버킷(public): landing-assets
# 서비스 계정 JSON (둘 중 하나 사용)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_SERVICE_ACCOUNT_JSON=

# FEED Life CRM 연동 (서버 전용 — NEXT_PUBLIC_ 접두사 금지, 프론트 노출 금지)
# 두 값이 모두 설정되기 전까지는 CRM 동기화가 실행되지 않고 기존 동작과 100% 동일하다.
# 값은 CRM 관리자가 운영 배포 시점에 별도의 보안 채널로 전달 (운영 전용으로 신규 발급)
CRM_LANDING_INGEST_URL=
CRM_LANDING_INGEST_SECRET=

# Web Push (관리자 CRM 알림)
# 키 생성: npx web-push generate-vapid-keys
# HTTPS(또는 localhost)에서만 동작. 헤더의「알림 켜기」로 구독.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:admin@feed-life.com

# Meta Marketing API (광고 소재 미리보기)
# Ads Manager → 비즈니스 설정 → 시스템 사용자 토큰 (ads_read)
# 광고 URL 예: https://www.feed-life.com/0715s?utm_source=facebook&utm_content={{ad.id}}&ad_id={{ad.id}}&adset_id={{adset.id}}&campaign_id={{campaign.id}}
META_ACCESS_TOKEN=
# (선택) 기본 광고 계정 ID — 미사용 시 ad_id만으로 조회
# META_AD_ACCOUNT_ID=

# 랜딩 행동 분석 이벤트 보관: Supabase에서 주기 실행 권장
# SELECT public.purge_landing_events_older_than(90);

